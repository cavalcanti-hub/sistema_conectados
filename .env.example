APP_NAME="Sistema Conectados"
APP_ENV=production
APP_DEBUG=false
APP_MODE=auto
APP_URL=https://sistema.exemplo.com.br
APP_BASE_PATH=
APP_TIMEZONE=America/Sao_Paulo

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Obsoleta: DDL automatico permanece desativado independentemente do valor.
DB_SKIP_AUTO_SCHEMA=true

MAX_IMAGE_WIDTH=1600
MAX_IMAGE_HEIGHT=1600
BACKUP_PATH=/home/usuario/backups_sistema_conectados

SESSION_NAME=conectados_session
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax
SESSION_LIFETIME=120

# Bootstrap opcional do primeiro administrador. Remova do .env apos o primeiro acesso.
ADMIN_NAME="Admin Conectados"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Segredo exclusivo exibido na configuracao de Webhooks do Mercado Pago.
MERCADO_PAGO_WEBHOOK_SECRET=
